{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nifty PM Authentication Folders API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Folders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List folders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.niftypm.com/api/v1.0/folders"
          },
          "docs": "List folders"
        },
        {
          "info": {
            "name": "Create a folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://openapi.niftypm.com/api/v1.0/folders"
          },
          "docs": "Create a folder"
        },
        {
          "info": {
            "name": "Get a folder",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.niftypm.com/api/v1.0/folders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a folder"
        },
        {
          "info": {
            "name": "Update a folder",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://openapi.niftypm.com/api/v1.0/folders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update a folder"
        },
        {
          "info": {
            "name": "Delete a folder",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://openapi.niftypm.com/api/v1.0/folders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a folder"
        }
      ]
    }
  ],
  "bundled": true
}