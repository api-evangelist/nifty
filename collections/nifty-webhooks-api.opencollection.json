{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nifty PM Authentication Webhooks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.niftypm.com/api/v1.0/webhooks"
          },
          "docs": "List webhooks"
        },
        {
          "info": {
            "name": "Create a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://openapi.niftypm.com/api/v1.0/webhooks"
          },
          "docs": "Create a webhook"
        },
        {
          "info": {
            "name": "Update a webhook",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://openapi.niftypm.com/api/v1.0/webhooks"
          },
          "docs": "Update a webhook"
        },
        {
          "info": {
            "name": "Delete a webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://openapi.niftypm.com/api/v1.0/webhooks"
          },
          "docs": "Delete a webhook"
        }
      ]
    }
  ],
  "bundled": true
}